      "id": "sp3.m4.t1",
      "title_en": "Foxy's playroom",
      "title_ru": "Игровая комната Фокси",
      "body_en": "This is Foxy's playroom. He has got a rocking horse, an aeroplane and a musical box. Whose tea set is this? It is his grandmother's present. Do not shout, be careful with the musical box!",
      "questions": [
        {
          "id": "sp3.m4.t1.q1",
          "kind": "choice",
          "q_en": "What is this?",
          "q_ru": "Что это за комната?",
          "options": [
            "Foxy's playroom",
            "Foxy's school",
            "Foxy's family tree"
          ],
          "answer": "Foxy's playroom"
        },
        {
          "id": "sp3.m4.t1.q2",
          "kind": "truefalse",
          "q_en": "The tea set is a present from Foxy's grandmother.",
          "q_ru": "Чайный сервиз — подарок от бабушки Фокси.",
          "options": [],
          "answer": "true"
        },
        {
          "id": "sp3.m4.t1.q3",
          "kind": "gap",
          "q_en": "Be careful with the ___ box!",
          "q_ru": "Будь осторожен с ___ коробочкой (музыкальной).",
          "options": [
            "musical",
            "lunch",
            "school"
          ],
          "answer": "musical"
        },
        {
