  "grammar": [
    {
      "id": "sp3.m3.g-does",
      "title_ru": "Do you like…? Does he like…? — любишь ли?",
      "rule_ru": "Про тебя, нас, них спрашиваем Do: Do you like rice? Про него или неё — Does, а в ответе he likes: He likes jelly.",
      "examples": [
        {
          "en": "Do you like chicken? Yes, I do.",
          "ru": "Ты любишь курицу? Да."
        },
        {
          "en": "He likes jelly.",
          "ru": "Он любит желе."
        }
      ],
      "items": [
        {
          "id": "sp3.m3.g-does.1",
          "prompt_en": "___ you like chicken?",
          "options": [
