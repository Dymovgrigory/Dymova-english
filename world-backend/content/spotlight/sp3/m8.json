    {
      "id": "sp3.m8.t1",
      "title_en": "Foxy's week",
      "title_ru": "Неделя Фокси",
      "body_en": "On Monday morning Foxy has got English. On Wednesday he visits his grandmother. He has lunch at 1 o'clock and supper at 6 o'clock. On Friday evening he watches a video and listens to music. On Sunday he watches a cartoon.",
      "questions": [
        {
          "id": "sp3.m8.t1.q1",
          "kind": "choice",
          "q_en": "When has Foxy got English?",
          "q_ru": "Когда у Фокси английский?",
          "options": [
            "On Monday morning",
            "On Friday evening",
            "On Sunday"
          ],
          "answer": "On Monday morning"
        },
        {
          "id": "sp3.m8.t1.q2",
          "kind": "truefalse",
          "q_en": "Foxy visits his grandmother on Wednesday.",
          "q_ru": "Фокси навещает бабушку в среду.",
