  "grammar": [
    {
      "id": "sp3.m5.g-has-got",
      "title_ru": "It has got… — у него есть",
      "rule_ru": "Про животное говорим it has got (it's got): It's got a long tail. Некоторые слова во множественном числе особенные: man — men, foot — feet, mouse — mice.",
      "examples": [
        {
          "en": "It's got a long tail.",
          "ru": "У него длинный хвост."
        },
        {
          "en": "Two mice are small.",
          "ru": "Две мышки маленькие."
        }
      ],
      "items": [
        {
          "id": "sp3.m5.g-has-got.1",
          "prompt_en": "A cow ___ got a long tail.",
          "options": [
            "has",
            "have"
          ],
          "answer": 0,
          "ru": "У коровы длинный хвост."
        },
        {
