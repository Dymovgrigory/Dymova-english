  "grammar": [
    {
      "id": "sp4.m2.g-often",
      "title_ru": "Always, sometimes, never — как часто?",
      "rule_ru": "Как часто: always — всегда, usually — обычно, sometimes — иногда, never — никогда. Ставим перед глаголом: I always wash the dishes.",
      "examples": [
        {
          "en": "I always wash the dishes.",
          "ru": "Я всегда мою посуду."
        },
        {
          "en": "It's half past three.",
          "ru": "Половина четвёртого."
        }
      ],
      "items": [
        {
          "id": "sp4.m2.g-often.1",
          "prompt_en": "I ___ play hockey. I don't like it.",
          "options": [
            "never",
            "always"
          ],
          "answer": 0,
          "ru": "Я никогда не играю в хоккей."
        },
        {
          "id": "sp4.m2.g-often.2",
          "prompt_en": "She ___ to school every day.",
          "options": [
            "goes",
            "go"
          ],
          "answer": 0,
          "ru": "Она ходит в школу каждый день."
        },
        {
