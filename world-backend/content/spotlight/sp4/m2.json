          "prompt_en": "It's half ___ five.",
          "options": [
            "past",
            "to"
          ],
          "answer": 0,
          "ru": "Половина шестого."
        },
        {
          "id": "sp4.m2.g-often.4",
          "prompt_en": "What ___ he do? He's a mechanic.",
          "options": [
            "does",
            "do"
          ],
          "answer": 0,
