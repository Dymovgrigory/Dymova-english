        }
      ]
    },
    {
      "id": "sp4.m2.g-have-to",
      "title_ru": "Have to — нужно, приходится",
      "rule_ru": "Have to — нужно, должен: I have to wash the dishes. Про него или неё — has to: A nurse has to wear a uniform.",
