  "grammar": [
    {
      "id": "sp4.m3.g-much-many",
      "title_ru": "How much? How many? — сколько?",
      "rule_ru": "Many — про то, что можно посчитать: how many tomatoes. Much — про то, что не считают: how much sugar. A lot of — много, подходит везде.",
      "examples": [
        {
          "en": "How much sugar do we need?",
          "ru": "Сколько сахара нам нужно?"
        },
        {
          "en": "How many tomatoes have we got?",
          "ru": "Сколько у нас помидоров?"
        }
      ],
      "items": [
        {
          "id": "sp4.m3.g-much-many.1",
          "prompt_en": "How ___ sugar do we need?",
          "options": [
