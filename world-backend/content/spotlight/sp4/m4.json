  "grammar": [
    {
      "id": "sp4.m4.g-compare",
      "title_ru": "Bigger than — больше, чем",
      "rule_ru": "Сравниваем: к короткому слову добавляем -er и than: big — bigger than, tall — taller than.",
      "examples": [
        {
          "en": "Whales are bigger than dolphins.",
          "ru": "Киты больше дельфинов."
        },
        {
          "en": "A giraffe is taller than a hippo.",
          "ru": "Жираф выше бегемота."
        }
      ],
      "items": [
        {
          "id": "sp4.m4.g-compare.1",
          "prompt_en": "A whale is ___ than a dolphin.",
          "options": [
            "big",
            "bigger"
          ],
          "answer": 1,
          "ru": "Кит больше дельфина."
        },
        {
          "id": "sp4.m4.g-compare.2",
          "prompt_en": "A giraffe is ___ than a hippo.",
          "options": [
            "taller",
            "tall"
          ],
          "answer": 0,
          "ru": "Жираф выше бегемота."
        },
        {
          "id": "sp4.m4.g-compare.3",
          "prompt_en": "A lizard is smaller ___ a crocodile.",
          "options": [
            "than",
            "then"
          ],
          "answer": 0,
          "ru": "Ящерица меньше крокодила."
        },
        {
          "id": "sp4.m4.g-compare.4",
          "prompt_en": "A seal is ___ than a kangaroo.",
          "options": [
            "lazier",
            "lazy"
          ],
          "answer": 0,
          "ru": "Тюлень ленивее кенгуру."
        }
      ]
    },
    {
      "id": "sp4.m4.g-must",
      "title_ru": "Must / mustn't — нужно, нельзя",
      "rule_ru": "Must — обязательно нужно: You must have a ticket. Mustn't — нельзя: You mustn't feed the animals.",
      "examples": [
        {
          "en": "You mustn't feed the animals.",
          "ru": "Нельзя кормить животных."
        },
        {
          "en": "You must have a ticket.",
          "ru": "У тебя должен быть билет."
        }
      ],
      "items": [
        {
          "id": "sp4.m4.g-must.1",
          "prompt_en": "You ___ feed the animals at the zoo.",
          "options": [
            "mustn't",
            "must"
          ],
          "answer": 0,
