  "texts": [
    {
      "id": "sp4.m8.t1",
      "title_en": "Foxy goes to Italy",
      "title_ru": "Фокси едет в Италию",
      "body_en": "Tomorrow Foxy will travel to Italy. He has got his swimsuit, sunglasses and flippers. He will go camping in the mountains by a lake. He has got a tent, boots and a sleeping bag. It will not be cloudy or rainy — cool!",
      "questions": [
        {
          "id": "sp4.m8.t1.q1",
          "kind": "choice",
          "q_en": "Where will Foxy travel?",
          "q_ru": "Куда Фокси отправится?",
          "options": [
            "To Italy",
            "To Spain",
            "To Greece"
          ],
          "answer": "To Italy"
        },
        {
          "id": "sp4.m8.t1.q2",
          "kind": "truefalse",
          "q_en": "Foxy has got his swimsuit.",
          "q_ru": "У Фокси есть купальник.",
          "options": [],
          "answer": "true"
        },
        {
          "id": "sp4.m8.t1.q3",
          "kind": "gap",
          "q_en": "Foxy will go camping in the ___.",
          "q_ru": "Фокси пойдёт в поход в ___ (горы).",
          "options": [
            "mountains",
            "tent",
            "lake"
          ],
          "answer": "mountains"
        },
        {
          "id": "sp4.m8.t1.q4",
          "kind": "choice",
          "q_en": "What has Foxy got for the lake?",
          "q_ru": "Что у Фокси есть для озера?",
          "options": [
            "His flippers",
            "His boots",
            "His uniform"
          ],
          "answer": "His flippers"
        },
