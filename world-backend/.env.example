# Dev: uvicorn main:app --host 127.0.0.1 --port 8010
# WORLD_DB_PATH=./data/world.sqlite
# CORS origins фронта:
# WORLD_CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# Верификация телефона при регистрации.
# 0 (по умолчанию) — код не отправляется, /registration/start возвращает dev_code.
# 1 — отправка через SMS Aero (нужны ключи ниже).
# PHONE_VERIFICATION_REQUIRED=0
# SMS Aero: email аккаунта, API-ключ и подпись отправителя (из кабинета smsaero.ru).
# SMSAERO_EMAIL=you@example.com
# SMSAERO_API_KEY=replace-me
# SMSAERO_SIGN=SMSAero

# Bootstrap первого админа (owner) при старте, если admin_users пуста.
# Создаётся один раз; дальше пароль менять только через БД.
# ADMIN_BOOTSTRAP_LOGIN=owner
# ADMIN_BOOTSTRAP_PASSWORD=replace-me

# Гейт обязательной регистрации (по умолчанию включён).
# 0 — выключить (локальная отладка); 1 — незарегистрированным ученикам 403 registration_required.
# REGISTRATION_GATE=1

# Вход через мини-приложения мессенджеров (docs/world/messenger-auth.md).
# Токен бота Telegram от @BotFather — нужен для проверки подписи initData.
# TELEGRAM_BOT_TOKEN=123456:replace-me
# Токен бота MAX (max.ru, платформа для партнёров) — та же схема подписи.
# MAX_BOT_TOKEN=replace-me
