# --- MAX Bot API ---
# Токен бота: платформа MAX → Чат-боты → Перейти → Расширенные настройки → Настроить
MAX_BOT_TOKEN=
# botapi.max.ru работает без доп. сертификатов. Новый домен platform-api2.max.ru
# требует корневой сертификат Минцифры на хосте (миграция до 19.07.2026).
MAX_BOT_API_URL=https://botapi.max.ru
# Произвольный секрет; если задан, проверяется в заголовке X-Max-Bot-Api-Secret
MAX_WEBHOOK_SECRET=

# --- LLM (бесплатный, OpenAI-совместимый) ---
# По умолчанию OpenRouter + бесплатная модель. Ключ создаётся бесплатно на
# https://openrouter.ai/keys . Можно заменить на Groq / локальный Ollama и т.п.
# Если используете OpenAI, задайте:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_FALLBACKS=[{"base_url":"https://api.openai.com/v1","api_key":"sk-...","model":"gpt-4o-mini"}]
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_FALLBACKS=[]
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=700
# Таймаут одного запроса и общий бюджет каскада провайдеров. Каскад обязан
# уложиться в бюджет, иначе пользователь просто ждёт в тишине.
LLM_TIMEOUT=40
LLM_TOTAL_BUDGET_SEC=45

# --- Роли моделей (LLM Gateway) ---
# Разным задачам нужны разные модели: диалогу с клиентом — лучшая,
# служебной классификации — быстрая и дешёвая. Пусто = взять LLM_MODEL.
# Подменяется модель только основного провайдера; запасные из LLM_FALLBACKS
# остаются со своими моделями (у чужого ключа этой модели может не быть).
# Рекомендованный production-стек — см. FOXINBURG_AI_2_ROADMAP.md.
# LLM_ROLE_REASONING=anthropic/claude-sonnet-5   # диалог, SMART, рекомендации
# LLM_ROLE_FAST=anthropic/claude-haiku-4.5       # намерение, эмоция, классификация
# LLM_ROLE_VISION=anthropic/claude-sonnet-5      # разбор фото домашки
# LLM_ROLE_CRITIC=anthropic/claude-haiku-4.5     # оценка ответа перед отправкой

# Прятать ФИО/телефон/даты за плейсхолдерами перед отправкой в модель.
# Бот собирает персональные данные детей — в открытом виде наружу они уходить
# не должны. Выключать только для локальной отладки промптов.
LLM_PII_REDACTION=true

# --- Дедлайны диалога ---
# Максимум ожидания ответа пользователем (включая очередь его же сообщений).
REPLY_TIMEOUT_SEC=60
# Через сколько секунд отправить промежуточное «секунду, уточняю».
SLOW_NOTICE_SEC=12

# --- BigBen CRM (интеграция с сайтом через API) ---
# URL запроса и ключ: CRM → Управление школой → Настройки школы → Интеграции →
# Работа с API → Сгенерировать. pipeline_id / pipeline_status_id — воронка и этап.
BIGBEN_API_URL=https://panel.bigbencrm.ru/api/leads/add
BIGBEN_API_KEY=
BIGBEN_PIPELINE_ID=1924
BIGBEN_PIPELINE_STATUS_ID=1

# --- Observability / notifications ---
# SENTRY_DSN=https://...
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Регистрация ---
# true — новый пользователь обязан представиться (ФИО родителя → имя ребёнка →
# возраст/дата рождения → телефон) до первого содержательного ответа бота.
# Контакты уходят в BigBen CRM, и только после этого открывается личный
# кабинет в мини-приложении (см. MINIAPP_REQUIRE_REGISTRATION).
REGISTRATION_REQUIRED=true

# --- Передача администратору ---
# ID администраторов в MAX через запятую (куда дублируется контекст диалога)
ADMIN_MAX_IDS=
# Токен админки: https://<домен>/admin/ (список клиентов, переписка, заявки,
# рассылки). Без него все /admin/* отвечают 401. Длинная случайная строка.
ADMIN_TOKEN=

# --- Мини-приложение ---
# Публичный URL мини-приложения (личный кабинет/витрина), напр. https://host/app/
MINIAPP_BASE_URL=
# Если true, miniapp будет считать профиль незарегистрированным, пока в MAX нет
# completed registration для этого user_id.
MINIAPP_REQUIRE_REGISTRATION=true
# Личность в API мини-приложения принимается ТОЛЬКО из подписанного initData.
# false — режим локальной отладки: начинает работать открытый ?user_id=,
# то есть любой сможет обратиться от чужого имени. В прод ставить нельзя.
MINIAPP_AUTH_REQUIRED=true
# Публичный HTTPS-URL Telegram Mini App. Пусто = {origin MINIAPP_BASE_URL}/tg/
TELEGRAM_MINIAPP_URL=

# --- Цикл улучшения: журнал вопросов без ответа и ежедневный отчёт ---
# INSIGHTS_FILE=./data/insights.jsonl  # JSONL-журнал вопросов без уверенного ответа
# DIGEST_ENABLED=true                  # ежедневный дайджест администраторам
# DIGEST_HOUR=21                       # час отправки (по DIGEST_TZ_OFFSET)
# DIGEST_MINUTE=0
# DIGEST_TZ_OFFSET=3                   # МСК
# DIGEST_DAYS=1                        # период отчёта в днях
# NUDGE_ENABLED=true                   # тёплые напоминания незавершённым заявкам
# NUDGE_HOUR=11
# NUDGE_MINUTE=0

# --- Живая синхронизация KB с сайтом ---
# SITE_SYNC_ENABLED=true               # подтягивать актуальный контент сайта в базу знаний
# SITE_SYNC_URLS=                      # URL через запятую; пусто = https://dymova-english.ru
# SITE_SYNC_INTERVAL_MIN=60            # период обновления в минутах

# --- Email-уведомления о заявках с сайта (миграция с Tilda) ---
# Gmail SMTP с App Password (не обычный пароль аккаунта):
# аккаунт Google → Безопасность → Пароли приложений → создать для "Почта".
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
# Кому дублировать заявку по почте, через запятую.
LEAD_NOTIFY_EMAILS=dymovgrigory@gmail.com,kidsfoxclub@yandex.ru

# --- Сайт (миграция с Tilda): разрешённые origin для формы заявки /api/lead ---
SITE_CORS_ORIGINS=https://dymova-english.ru,https://new.dymova-english.ru,https://www.dymova-english.ru

# --- Прочее ---
# Персистентность диалогов и таблицы обработанных событий между рестартами.
# Значение по умолчанию (./data/bot.db) РАБОТАЕТ: раньше оно молча
# подменялось на in-memory, и бот терял всю историю при каждом рестарте.
# Явный ":memory:" отключает персистентность (используется в тестах).
DB_PATH=./data/bot.db
# STATE_FILE=             # legacy alias для DB_PATH

# --- Сторож доступности (мониторинг внешних каналов) ---
# WATCHDOG_ENABLED=true
# WATCHDOG_INTERVAL_MIN=5              # как часто проверять getMe
# WATCHDOG_FAILURES_BEFORE_ALERT=2     # провалов подряд до тревоги
# WATCHDOG_ALERT_COOLDOWN_MIN=60       # не чаще одной тревоги в час
# WATCHDOG_POLL_SILENCE_MIN=5          # опрос молчит дольше — тревога
# TELEGRAM_API_IPS=                    # адреса для подсказки рабочего IP
