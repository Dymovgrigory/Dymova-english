# Caddy выпускает HTTPS-сертификат автоматически. Замените домен на свой
# (A-запись домена должна указывать на IP сервера).
#
# Явно закрепляем production ACME для всех блоков ниже. На этом сервере
# в /data/caddy/acme/ остался ещё и staging-аккаунт Let's Encrypt (с ранних
# тестов DNS-фикса, см. DEVLOG "Сессия 25") — без этой глобальной опции
# Caddy для новых доменов подхватывал именно его, выдавая недоверенный
# браузерами staging-сертификат вместо настоящего.
{
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

# Вариант для docker compose (бот доступен по имени сервиса bot):
bot.dymova-english.ru {
    # Журнал доступа нужен, чтобы отличать «мессенджер не смог открыть
    # мини-приложение» от «мессенджер к нам вообще не приходил»: без него
    # видно только запросы, дошедшие до uvicorn.
    log {
        # /data — том caddy_data, журнал переживает пересоздание контейнера.
        output file /data/bot-access.log
        format json
    }
    # Корень отдаём мини-приложению MAX. Причина: в требованиях MAX к ссылке
    # перечислены только буквы, цифры, точки и дефисы — косой черты в списке
    # нет, и есть подозрение, что адрес с путём (/app/) там не принимается.
    # Так в кабинет можно вписать хост без пути. Раньше корень отдавал 404,
    # так что ничего не перекрываем. 302, чтобы легко откатить.
    redir / /app/ 302
    reverse_proxy bot:8000
}

# Если разворачиваете БЕЗ Docker (systemd) — бот слушает localhost:8000,
# тогда используйте такой блок вместо верхнего:
# bot.dymova-english.ru {
#     reverse_proxy localhost:8000
# }

# Основной сайт (миграция с Tilda завершена, см. DEVLOG.md "Сессия 28"/29
# и wiki/02-arhitektura.md). Собранные файлы (prototype/build_static_site.py,
# прод-режим — без --noindex) лежат в /srv/foxinburg-site на хосте — том
# пробрасывается в контейнер тем же способом, что и Caddyfile. Активируется
# автоматически, как только A-запись apex/www-домена укажет на этот сервер.
#
# /members/* — исключение: это фича личного кабинета Tilda (Tilda Members),
# которой нет в статической сборке. Пока не появится свой личный кабинет,
# этот путь редиректит на tilda-members.tilda.ws — бесплатный системный
# поддомен проекта 2053071 в самой Tilda (Настройки сайта → Главное →
# «Субдомен на Тильде»), с уже валидным HTTPS от Tilda — отдельная DNS-запись
# и алиас домена не нужны. См. дизайн-документ
# docs/superpowers/specs/2026-07-28-tilda-members-proxy-design.md.
#
# Раньше здесь был reverse_proxy (server-to-server на Tilda) — не пошло:
# DDoS-Guard перед Tilda блокирует запросы, приходящие с IP этого сервера
# (датацентр Yandex Cloud), отдавая 425 "D'oh!" вместо страницы входа —
# ломало бы кабинет для всех посетителей одинаково. Редирект избегает
# этого: браузер посетителя подключается к Tilda напрямую, своим обычным
# IP, а не через наш сервер.
# www — навсегда на apex (301), чтобы не плодить дубли в индексации
# и не делить ссылочный вес между двумя хостами.
www.dymova-english.ru {
    redir https://dymova-english.ru{uri} 301
}

dymova-english.ru {
    handle /members/* {
        redir https://tilda-members.tilda.ws{uri} 302
    }

    root * /srv/foxinburg-site
    try_files {path} {path}/index.html

    # Кэширование статики. Имена файлов БЕЗ хэшей в URL — поэтому только
    # неделя (max-age=604800), immutable и год ставить НЕЛЬЗЯ: при замене
    # файла клиенты должны получить новую версию в обозримый срок.
    @static path /mascot/* /wow/* /assets/* /gallery/* /team-media/* /media/* /favicon.png /og-cover.png
    header @static Cache-Control "public, max-age=604800"

    # Security-заголовки. HSTS намеренно БЕЗ includeSubDomains — на
    # поддоменах (bot./lms./mcp./new.) тоже HTTPS, но не рискуем ломать
    # будущие поддомены принудительным TLS.
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000"
    }

    # сжатие текстовых ассетов (JS/CSS/HTML/SVG): three.js и прочие модули
    # едут в 3-4 раза быстрее — критично для скорости появления заставки
    encode zstd gzip
    file_server
}

# Стейджинг/предпросмотр (тот же контент). Оставлен как отдельный alias
# после переключения DNS — canonical-теги на страницах указывают на apex,
# так что риска дублей в индексации нет.
new.dymova-english.ru {
    root * /srv/foxinburg-site
    try_files {path} {path}/index.html
    # стейджинг не должен индексироваться — дублируем noindex заголовком
    # (на страницах стейджинг-сборки уже есть meta robots, но бинарные
    # ассеты и старые копии заголовок надёжнее)
    header X-Robots-Tag "noindex, nofollow"
    encode zstd gzip
    file_server
}

# LMS (личный кабинет + админка): Next.js frontend + FastAPI backend из
# репозитория Dymovgrigory/LMS. Контейнеры lms-frontend/lms-backend живут
# в docker-сети foxinburg_foxinburg — Caddy подключён к ней (см. networks
# в docker-compose.yml). Раньше LMS проксировал nginx стека Foxinburg-EBOS;
# после переезда сайта на этот Caddy тот nginx потерял порты 80/443, и LMS
# стала недоступна извне — этот блок возвращает её в публичность.
lms.dymova-english.ru {
    handle /api/* {
        reverse_proxy lms-backend:8000
    }
    handle /health {
        reverse_proxy lms-backend:8000
    }
    handle {
        reverse_proxy lms-frontend:3000
    }
}

# gbrain MCP endpoints, exposed for the Hermes agent (Timeweb server) to
# reach — see docs/hermes-integration.md in the gbrain repo on foxinburg-vm.
# Auth (Bearer/HMAC) is enforced by the MCP services themselves; Caddy here
# is a plain reverse proxy. The services are host-level systemd units
# (memory:8767, recall:8768, swarm:8766), not Docker containers, hence
# host.docker.internal instead of a compose service name.
mcp.dymova-english.ru {
    handle_path /memory/* {
        reverse_proxy host.docker.internal:8767
    }
    handle_path /recall/* {
        reverse_proxy host.docker.internal:8768
    }
    handle_path /swarm/* {
        reverse_proxy host.docker.internal:8766
    }
}
